{# One macro renders any section. A section's id comes from paper.pages in the
   config; its type is sections.<id>.type, or the id itself for built-ins. #}

{% macro section(id, c, cfg, compact=false) %}
{%- set opt = (cfg.sections or {}).get(id) or {} -%}
{%- set type = opt.type or id -%}
{%- set defaults = {
  "headlines": "Headlines", "trends": "Trends", "newsletters": "From your inbox",
  "quote": "", "vocabulary": "Words of the day", "phrase": "Phrase",
  "lesson": "Today's lesson", "speaking": "Speak", "drill": "Say it better",
  "pronunciation": "Say it clearly", "reflection": "Reflect", "checklist": "Today",
} -%}
{%- set title = opt.title or defaults.get(type, id|replace("_", " ")|title) -%}

{%- if type == "headlines" and c.headlines -%}
  <h2>{{ title }}</h2>
  {%- for h in (c.headlines[:3] if compact else c.headlines) %}
  <p class="kicker">{{ h.topic }}</p>
  {%- if compact %}
  <p class="story"><b>{{ h.title }}.</b> {{ h.summary }}</p>
  {%- else %}
  <article class="story"><h3>{{ h.title }}</h3>
    <p>{{ h.summary }}{% if h.source %} <span class="src">({{ h.source }})</span>{% endif %}</p></article>
  {%- endif %}
  {%- endfor %}

{%- elif type == "newsletters" and c.newsletters -%}
  <h2>{{ title }}</h2>
  <ul class="tight">{% for n in (c.newsletters[:4] if compact else c.newsletters) %}<li><b>{{ n.name }}:</b> {{ n.takeaway }}</li>{% endfor %}</ul>

{%- elif type == "trends" and c.trends -%}
  <h2>{{ title }}</h2>
  {%- if compact %}
  <ul class="tight">{% for t in c.trends %}<li><b>{{ t.area }}:</b> {{ t.points[0] }}</li>{% endfor %}</ul>
  {%- else %}
  {%- for t in c.trends %}
  <p class="kicker">{{ t.area }}</p>
  <ul class="tight">{% for p in t.points %}<li>{{ p }}</li>{% endfor %}</ul>
  {%- endfor %}
  {%- endif %}

{%- elif type == "quote" and c.quote -%}
  <blockquote>“{{ c.quote.text }}”<cite>— {{ c.quote.author }}</cite></blockquote>

{%- elif type == "vocabulary" and c.words -%}
  <h2>{{ title }}</h2>
  {%- for w in c.words %}
  <div class="word">
    <p><b class="w">{{ w.word }}</b> <span class="pos">{{ w.pos }}</span>{% if w.ipa and not compact %} <span class="ipa">{{ w.ipa }}</span>{% endif %}{% if compact %}: {{ w.meaning }}{% endif %}</p>
    {%- if not compact %}<p>{{ w.meaning }}</p>{% endif %}
    <p class="ex">“{{ w.example }}”</p>
    {%- if w.use_it and not compact %}<p class="use">Use it: {{ w.use_it }}</p>{% endif %}
  </div>
  {%- endfor %}
  {%- if c.review_words %}
  <p class="sub">Review</p>
  <ul class="tight">{% for r in c.review_words %}<li><b>{{ r.word }}</b>: {{ r.prompt }}</li>{% endfor %}</ul>
  {%- endif %}

{%- elif type == "phrase" and c.phrase -%}
  <h2>{{ title }}</h2>
  <p><b>{{ c.phrase.text }}</b>: {{ c.phrase.meaning }}</p>
  {%- if c.phrase.example and not compact %}<p class="ex">“{{ c.phrase.example }}”</p>{% endif %}

{%- elif type == "lesson" and c.lesson -%}
  <h2>{{ title }}: {{ c.lesson.title }}</h2>
  <p>{{ c.lesson.body }}</p>
  {%- if c.lesson.try_it %}<p class="use">Try it: {{ c.lesson.try_it }}</p>{% endif %}

{%- elif type == "speaking" and c.speaking -%}
  <div class="box">
    <h2>{{ title }} for {{ c.speaking.time or "60 seconds" }}</h2>
    <p><b>{{ c.speaking.prompt }}</b></p>
    {%- if c.speaking.structure %}<ol class="tight">{% for s in c.speaking.structure %}<li>{{ s }}</li>{% endfor %}</ol>{% endif %}
  </div>

{%- elif type == "drill" and c.drill -%}
  <h2>{{ title }}</h2>
  <p class="faint">{{ c.drill.instruction }}</p>
  <ol class="tight">{% for s in c.drill.sentences %}<li>{{ s }}</li>{% endfor %}</ol>
  {%- if c.answer_key %}<p class="faint">Yesterday's answers: {% for a in c.answer_key %}{{ loop.index }}. {{ a }} {% endfor %}</p>{% endif %}

{%- elif type == "pronunciation" and c.pronunciation and not compact -%}
  <h2>{{ title }}</h2>
  <p class="ex">{{ c.pronunciation.text }}</p>
  <p class="faint">{{ c.pronunciation.tip }}</p>

{%- elif type == "reflection" and c.reflection -%}
  <h2>{{ title }}</h2>
  <p>{{ c.reflection }}</p>
  {%- if not compact %}<div class="lines"><span></span><span></span><span></span><span></span></div>{% endif %}

{%- elif type == "checklist" and opt.get("items") and not compact -%}
  <div class="box checklist">
    <h2>{{ title }}</h2>
    {%- for item in opt["items"] %}<p><i class="tick"></i>{{ item }}</p>{% endfor %}
  </div>

{%- elif type == "custom" and c.get(id) -%}
  {%- set x = c.get(id) -%}
  <h2>{{ title }}</h2>
  {%- if x.body %}<p>{{ x.body }}</p>{% endif %}
  {%- if x["items"] %}<ul class="tight">{% for i in x["items"] %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
{%- endif -%}
{% endmacro %}
