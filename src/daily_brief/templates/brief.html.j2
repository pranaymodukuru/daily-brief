{% import "blocks.html.j2" as k %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }} · {{ c.date }}</title>
<style>{{ css }}</style>
</head>
<body>
{% for page in c.pages %}
<section class="page{% if loop.first %} front{% endif %}">
  {% if loop.first %}
  <header class="masthead">
    <div class="meta"><span>No. {{ c.edition }}</span><span>{{ long_date }}</span><span>{{ cfg.reader.name }}'s edition</span></div>
    <h1>{{ title }}</h1>
    {% if c.greeting %}<p class="greeting">{{ c.greeting }}</p>{% endif %}
    {% if c.weather %}<p class="weather">{{ c.weather }}</p>{% endif %}
  </header>
  {% if c.top %}<div class="top3"><b>In 30 seconds</b><ol>{% for t in c.top %}<li>{{ t }}</li>{% endfor %}</ol></div>{% endif %}
  {% elif page.heading %}
  <header class="band"><h2>{{ page.heading }}</h2>{% if page.subheading %}<span>{{ page.subheading }}</span>{% endif %}</header>
  {% endif %}
  <div class="cols">
    <div class="col-a">{% for b in page.left or [] %}{{ k.block(b) }}{% endfor %}</div>
    <div class="col-b">{% for b in page.right or [] %}{{ k.block(b) }}{% endfor %}</div>
  </div>
</section>
{% endfor %}
</body>
</html>
