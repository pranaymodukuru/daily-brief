{# Generic building blocks. The agent designs sections from the reader's
   wishes and expresses each one as a block of one of these kinds. #}

{% macro block(b, compact=false) %}
{%- set k = b.kind -%}
{%- if b.title and k not in ("prompt", "quote", "checklist") %}<h2>{{ b.title }}</h2>{% endif -%}

{%- if k == "news" -%}
  {%- for h in (b["items"][:3] if compact else b["items"]) %}
  {%- if h.topic %}<p class="kicker">{{ h.topic }}</p>{% endif %}
  {%- if compact %}
  <p class="story"><b>{{ h.title }}.</b> {{ h.summary }}</p>{% if h.stamp %}<p class="stamp">{{ h.stamp }}</p>{% endif %}
  {%- elif h.points %}
  <article class="story lead"><h3>{{ h.title }}</h3>
    <p>{{ h.summary }}</p>
    <ul class="tight">{% for pt in h.points %}<li>{{ pt }}</li>{% endfor %}</ul>
    {%- if h.source %}<p class="src">{{ h.source }}</p>{% endif %}
    {%- if h.stamp %}<p class="stamp">{{ h.stamp }}</p>{% endif %}</article>
  {%- else %}
  <article class="story"><h3>{{ h.title }}</h3>
    <p>{{ h.summary }}{% if h.source %} <span class="src">({{ h.source }})</span>{% endif %}</p>
    {%- if h.stamp %}<p class="stamp">{{ h.stamp }}</p>{% endif %}</article>
  {%- endif %}
  {%- endfor %}

{%- elif k == "list" -%}
  {%- if b.intro %}<p class="faint">{{ b.intro }}</p>{% endif %}
  {%- set tag = "ol" if b.ordered else "ul" %}
  {%- if not b["items"] %}<p class="faint">{{ b.empty or "Nothing today." }}</p>{% endif %}
  {%- if b["items"] %}<{{ tag }} class="tight">{% for i in b["items"] %}<li>{% if i is mapping %}{{ i.text }}{% if i.stamp %}<span class="stamp">{{ i.stamp }}</span>{% endif %}{% else %}{{ i }}{% endif %}</li>{% endfor %}</{{ tag }}>{% endif %}

{%- elif k == "text" -%}
  <p>{{ b.body }}</p>
  {%- if b.note %}<p class="use">{{ b.note }}</p>{% endif %}

{%- elif k == "terms" and b.dense -%}
  <table class="dense">{% for t in b["items"] %}<tr><td><b>{{ t.term }}</b>{% if t.level %} <span class="lvl">{{ t.level }}</span>{% endif %}</td><td>{{ t.meaning }}</td>{% if not compact %}<td class="ex">{{ t.example or "" }}</td>{% endif %}</tr>{% endfor %}</table>

{%- elif k == "terms" -%}
  {%- for t in b["items"] %}
  <div class="word">
    <p><b class="w">{{ t.term }}</b>{% if t.level %} <span class="lvl">{{ t.level }}</span>{% endif %}{% if t.pos %} <span class="pos">{{ t.pos }}</span>{% endif %}{% if t.pron and not compact %} <span class="ipa">{{ t.pron }}</span>{% endif %}{% if compact %}: {{ t.meaning }}{% endif %}</p>
    {%- if not compact %}<p>{{ t.meaning }}</p>{% endif %}
    {%- if t.example %}<p class="ex">“{{ t.example }}”</p>{% endif %}
    {%- for e in t.examples or [] %}<p class="ex">“{{ e }}”</p>{% endfor %}
    {%- if t.tip and not compact %}<p class="use">{{ t.tip }}</p>{% endif %}
  </div>
  {%- endfor %}

{%- elif k == "prompt" -%}
  <div class="box">
    {%- if b.title %}<h2>{{ b.title }}</h2>{% endif %}
    <p><b>{{ b.body }}</b></p>
    {%- if b.steps %}<ol class="tight">{% for s in b.steps %}<li>{{ s }}</li>{% endfor %}</ol>{% endif %}
  </div>

{%- elif k == "quote" -%}
  <blockquote>“{{ b.text }}”<cite>— {{ b.author }}</cite></blockquote>

{%- elif k == "lines" -%}
  {%- if b.prompt %}<p>{{ b.prompt }}</p>{% endif %}
  {%- if not compact %}<div class="lines">{% for _ in range(b.count or 4) %}<span></span>{% endfor %}</div>{% endif %}

{%- elif k == "agenda" -%}
  {%- if b["items"] %}
  <table class="agenda">{% for e in b["items"] %}<tr><td class="t">{{ e.time }}</td><td><b>{{ e.title }}</b>{% if e.note %} <span class="faint">{{ e.note }}</span>{% endif %}</td></tr>{% endfor %}</table>
  {%- else %}<p class="faint">{{ b.empty or "No meetings today." }}</p>{% endif %}

{%- elif k == "exercise" -%}
  {%- if b.intro %}<p class="faint">{{ b.intro }}</p>{% endif %}
  {%- if b.body %}<p>{{ b.body }}</p>{% endif %}
  <ol class="tight ex-items">{% for i in b["items"] %}<li>{{ i }}{% if not compact %}{% for _ in range(b.get("lines", 1)) %}<span class="wline"></span>{% endfor %}{% endif %}</li>{% endfor %}</ol>

{%- elif k == "sudoku" -%}
  <div class="sudoku-wrap">
    <table class="sudoku">{% for r in range(9) %}<tr>{% for c in range(9) %}{% set v = b.grid[r * 9 + c] %}<td{% if c % 3 == 2 and c < 8 %} class="rb"{% endif %}>{{ v or "" }}</td>{% endfor %}</tr>{% endfor %}</table>
    {%- if b.prev_solution and not compact %}
    <div class="prev"><p class="faint">Yesterday's solution</p>
      <table class="sudoku mini">{% for r in range(9) %}<tr>{% for c in range(9) %}<td{% if c % 3 == 2 and c < 8 %} class="rb"{% endif %}>{{ b.prev_solution[r * 9 + c] }}</td>{% endfor %}</tr>{% endfor %}</table>
    </div>
    {%- endif %}
  </div>

{%- elif k == "diagram" -%}
  <figure class="diagram">
    {%- if b.svg_html %}{{ b.svg_html }}{% endif %}
    {%- if b.caption %}<figcaption class="faint">{{ b.caption }}</figcaption>{% endif %}
  </figure>

{%- elif k == "stat" -%}
  <p class="stat"><span class="num">{{ b.value }}</span> {{ b.body }}</p>
  {%- if b.stamp %}<p class="stamp">{{ b.stamp }}</p>{% endif %}

{%- elif k == "checklist" and not compact -%}
  {%- if b.inline %}
  <p class="strip">{% if b.title %}<b>{{ b.title }}</b>{% endif %}{% for i in b["items"] %}<span><i class="tick"></i>{{ i }}</span>{% endfor %}</p>
  {%- else %}
  <div class="box checklist">
    {%- if b.title %}<h2>{{ b.title }}</h2>{% endif %}
    {%- for i in b["items"] %}<p><i class="tick"></i>{{ i }}</p>{% endfor %}
  </div>
  {%- endif %}
{%- endif -%}
{% endmacro %}
